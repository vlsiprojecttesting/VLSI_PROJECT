    .TRANS_SIZE(${TRANS_SIZE})
) ${INSTANCE_NAME} (
    .hclk(${CLK}),
    .sram_clk(sram_clk),
    .hresetn(${RESET}),
    .stop_trans(stop_trans),
    .start_trans(start_trans),
    .ext_haddr(ext_haddr),
    .ext_hwdata(ext_hwdata),
    .ext_hwrite(ext_hwrite),
    .ext_hburst(ext_hburst),
    .ext_hsize(ext_hsize),
    .dft_en(dft_en),
    .bist_en(bist_en),
    .o_hrdata(hrdata)
);
