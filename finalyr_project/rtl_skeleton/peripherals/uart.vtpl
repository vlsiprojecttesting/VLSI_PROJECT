
uart #(
    .CLKS_PER_BIT(${CLKS_PER_BIT})
) ${INSTANCE_NAME} (
    .reset(${RESET}),
    .txclk(${CLK}),
    .ld_tx_data(ld_tx_data),
    .tx_data(tx_data),
    .rxclk(${CLK}),
    .rx_in(rx_in),    
    .tx_out(tx_out),
    .tx_empty(tx_empty),
    .rx_data(rx_data),
    .rx_empty(rx_empty)
);
